FROM debian:12-slim

ENV PYTHONUNBUFFERED=1
ENV HERMES_HOME=/root/.hermes
ENV PATH="/root/.local/bin:${PATH}"
ENV UV_NO_CONFIG=1

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# clone hermes 源码
RUN git clone --depth=1 https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent

WORKDIR /opt/hermes-agent

# 安装 Python 3.11 + 依赖（用 uv.lock 做 hash 验证）
RUN /root/.local/bin/uv python install 3.11 \
    && /root/.local/bin/uv venv venv --python 3.11 \
    && UV_PROJECT_ENVIRONMENT=/opt/hermes-agent/venv \
       /root/.local/bin/uv sync --extra messaging --extra cron --locked

# 安装 akshare 到 hermes venv
RUN /root/.local/bin/uv pip install --no-cache-dir \
    --python /opt/hermes-agent/venv/bin/python \
    "akshare>=1.18.0"

# symlink hermes 命令
RUN mkdir -p /root/.local/bin \
    && ln -sf /opt/hermes-agent/venv/bin/hermes /root/.local/bin/hermes

# 复制 skills 和配置
RUN mkdir -p /root/.hermes/skills/finance
COPY hermes/skills/finance/ /root/.hermes/skills/finance/

# 复制 sniper-bot 源码（供 skill 里的 Python 脚本调用）
COPY src/ /app/src/
COPY config/config.example.json /app/config/config.json

# 启动脚本：从环境变量生成 .env，然后跑 gateway
COPY docker/hermes-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /app
ENTRYPOINT ["/entrypoint.sh"]
